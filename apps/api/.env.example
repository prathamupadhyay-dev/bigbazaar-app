PORT=3000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# SMTP — use Resend / SendGrid / Brevo in production (NOT Mailtrap)
# Resend:   host=smtp.resend.com  port=465  user=resend  pass=<API_KEY>
# SendGrid: host=smtp.sendgrid.net port=465 user=apikey  pass=<API_KEY>
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@yourdomain.com

# Your deployed frontend URL — used in password reset email links
CLIENT_URL=https://yourdomain.com

# Admin registration secret — generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET_KEY=
